<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="create_po_form_view" model="ir.ui.view">
        <field name="name">create.po.form.view</field>
        <field name="model">create.po</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
<!--                        <field name="line_ids" invisible="create_type == 'po'" />-->
                        <field name="partner_ids" widget="many2many_tags" invisible="create_type == 'in'"/>
                        <field name="destination_location_id" invisible="create_type == 'po'" domain="[('usage','=','internal')]"/>
                    </group>
                    <footer>
                        <button name="action_create_purchase_order" type="object" class="btn-primary"
                                string="Create PO" invisible="create_type == 'in'"/>
                        <button name="action_create_internal_transfer" type="object" class="btn-primary"
                                string="Create Internal Transfer" invisible="create_type == 'po'"/>
                        <button class="btn-primary" string="Cancel" special="cancel"/>
                    </footer>

                </sheet>
            </form>
        </field>
    </record>


</odoo>
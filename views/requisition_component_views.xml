<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="requisition_component_form_view" model="ir.ui.view">
        <field name="name">requisition.component.form.view</field>
        <field name="model">requisition.component</field>
        <field name="arch" type="xml">
            <form>
                <header>

                    <button name="action_request"
                            class="btn-primary"
                            type="object"
                            string="Request"
                            groups="components_request.requisition_group_user"
                            invisible="state != 'draft'"/>

                    <button name="action_manager"
                            class="btn-primary"
                            type="object"
                            string="Approve Manager"
                            groups="components_request.requisition_group_manager"
                            invisible="state != 'requested'"/>

                    <button name="action_head"
                            class="btn-primary"
                            type="object"
                            string="Approve Head"
                            groups="components_request.requisition_group_head"
                            invisible="state != 'manager'"/>

                    <button name="action_reject"
                            class="btn-primary"
                            type="object"
                            string="Reject"
                            groups="components_request.requisition_group_head"
                            invisible="state != 'manager'"/>

                    <button name="%(action_create_po)d"
                            class="btn-primary"
                            type="action"
                            string="Create PO"
                            groups="components_request.requisition_group_head"
                            invisible="not create_po"/>

                    <button  name="%(action_create_in)d"
                             class="btn-primary"
                             type="action"
                             string="Internal Transfer"
                             groups="components_request.requisition_group_head"
                             invisible="not create_internal_transfer"/>

                    <field name="state" widget="statusbar" readonly="true"/>
                </header>
                <sheet>
                    <group>
                        <field name="employee_id"/>
                    </group>
                    <notebook>
                        <page string="Product Lines">
                            <field name="line_ids" readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="requisition_component_list_view" model="ir.ui.view">
        <field name="name">requisition.component.form.view</field>
        <field name="model">requisition.component</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id" string="Name"/>
                <field name="state" string="State"/>
            </list>
        </field>
    </record>

<!--   Requisition Line List View -->
    <record id="requisition_line_list_view" model="ir.ui.view">
        <field name="name">requisition.line.list</field>
        <field name="model">requisition.line</field>
        <field name="arch" type="xml">
            <list string="Product Lines" editable="bottom">
                <field name="product_id" string="Product"/>
                <field name="quantity" string="Quantity"/>
                <button type="object" icon="fa-check" string="Purchase Order"/>
                <button type="object" icon="fa-check" string="Internal Transfer"/>
            </list>
        </field>
    </record>

    <record id="action_requisition_component" model="ir.actions.act_window">
        <field name="name">Requisition Component</field>
        <field name="res_model">requisition.component</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>